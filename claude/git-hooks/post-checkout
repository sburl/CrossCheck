#!/bin/bash
# Post-checkout hook: clean environment after a branch switch.
#
# GIT-6250: this hook used to run in every repo, including scratch clones
# under /tmp, and it killed python/node/npm. That deleted nothing on purpose
# but left working trees showing mass deletions and broke .venv pip installs.
# Cleanup now no-ops outside managed workspace roots, never rewrites tracked
# files, and only signals pytest/jest/vitest processes whose cwd is the repo.

# shellcheck disable=SC2034  # prev_head, new_head used by git hook protocol
prev_head=$1
new_head=$2
branch_checkout=$3

# Only run on branch checkout (not file checkout)
if [ "$branch_checkout" != "1" ]; then
    exit 0
fi

repo_path=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
physical=$(cd "$repo_path" && pwd -P) || exit 0

# Scratch clones, macOS temp dirs, and anything outside the allowlist are
# left untouched. CROSSCHECK_HOOK_ALLOW_UNMANAGED=1 is the test override.
if [ "${CROSSCHECK_HOOK_ALLOW_UNMANAGED:-}" != "1" ]; then
    case "$physical" in
        /tmp | /tmp/* | /private/tmp | /private/tmp/* | /var/folders | /var/folders/*)
            exit 0
            ;;
    esac

    managed=0
    roots="${CROSSCHECK_MANAGED_ROOTS:-$HOME/developer}"
    IFS=':' read -r -a root_list <<< "$roots"
    for root in "${root_list[@]}"; do
        [ -n "$root" ] || continue
        root_phys=$(cd "$root" 2>/dev/null && pwd -P) || continue
        case "$physical" in
            "$root_phys" | "$root_phys"/*)
                managed=1
                break
                ;;
        esac
    done
    if [ "$managed" -ne 1 ]; then
        exit 0
    fi
fi

echo "🔄 Branch switched: cleaning up environment"
echo "  🧹 Killing orphan test processes in $repo_path..."

# Match a test runner as argv0, or as the first non-flag argument after an
# interpreter. Do not scan later arguments: "pip install pytest" and
# "npm install jest" must survive a branch switch.
if command -v ps > /dev/null 2>&1; then
    pids=$(ps -axo pid=,command= | awk '
        function base(arg, parts, n) {
            n = split(arg, parts, "/")
            return parts[n]
        }
        function is_runner(arg) {
            return base(arg) ~ /^(pytest|jest|vitest)$/
        }
        function is_interp(arg, b) {
            b = base(arg)
            return b ~ /^(python[0-9.]*|Python[0-9.]*|node|sh|bash|env)$/
        }
        {
            if (NF < 2) {
                next
            }
            if (is_runner($2)) {
                print $1
                next
            }
            if (!is_interp($2)) {
                next
            }
            for (i = 3; i <= NF; i++) {
                if ($i ~ /^-/) {
                    continue
                }
                if (is_runner($i)) {
                    print $1
                }
                break
            }
        }
    ')
    if [ -n "$pids" ]; then
        killed=0
        while IFS= read -r pid; do
            [ -n "$pid" ] || continue
            cwd=""
            if [ -d "/proc/$pid" ]; then
                cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null || true)
            elif command -v lsof > /dev/null 2>&1; then
                cwd=$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | awk '/^n/ { print substr($0, 2); exit }')
            fi
            [ -n "$cwd" ] || continue
            if [ -d "$cwd" ]; then
                cwd=$(cd "$cwd" && pwd -P)
            fi
            case "$cwd" in
                "$physical"/.venv | "$physical"/.venv/* | "$physical"/node_modules | "$physical"/node_modules/*)
                    continue
                    ;;
                "$physical" | "$physical"/*)
                    ;;
                *)
                    continue
                    ;;
            esac
            kill "$pid" 2>/dev/null || true
            killed=1
        done <<< "$pids"
        if [ "$killed" -eq 1 ]; then
            echo "  ✅ Killed repo-specific test processes"
        fi
    fi
fi

# Untracked scratch directory only. A symlink must not be followed, and a
# tracked path must not be removed.
if [ -d .tmp ] && [ ! -L .tmp ]; then
    if [ -z "$(git ls-files -- .tmp)" ]; then
        echo "  🗑️  Cleaning .tmp directory..."
        find .tmp -mindepth 1 -maxdepth 1 -exec rm -rf {} +
    fi
fi

echo "✅ Environment cleaned for new branch"
